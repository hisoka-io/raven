# raven-railgun-ppoi-replay: serves a recorded PPOI list capture over the upstream node's
# JSON-RPC methods. The image holds the binary only; mount a capture folder at /capture.
# Build context MUST be the repo root:
#   docker build -t raven-railgun-ppoi-replay -f adapters/railgun/Dockerfile.ppoi-replay .
#   docker run -v <capture folder>:/capture:ro -p 8088:8088 raven-railgun-ppoi-replay

FROM rust:1.98.0-slim-bookworm AS build
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        pkg-config libssl-dev clang lld git ca-certificates \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /build
COPY rust-toolchain.toml ./
COPY crates/inspire ./crates/inspire
COPY adapters/railgun ./adapters/railgun
RUN cargo build --release \
        --manifest-path adapters/railgun/Cargo.toml \
        --bin raven-railgun-ppoi-replay

FROM debian:bookworm-slim AS runtime
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        ca-certificates curl tini \
 && rm -rf /var/lib/apt/lists/* \
 && groupadd --system --gid 1500 raven \
 && useradd  --system --uid 1500 --gid 1500 --home-dir /capture --shell /usr/sbin/nologin raven
COPY --from=build /build/adapters/railgun/target/release/raven-railgun-ppoi-replay \
     /usr/local/bin/raven-railgun-ppoi-replay
ENV RUST_LOG="info" \
    PPOI_REPLAY_CAPTURE="/capture"
EXPOSE 8088
HEALTHCHECK --interval=30s --timeout=5s --retries=3 --start-period=15s \
    CMD curl -sf -X POST -H 'content-type: application/json' \
        -d '{"jsonrpc":"2.0","method":"ppoi_node_status","params":{},"id":1}' \
        http://localhost:8088/ >/dev/null || exit 1
USER raven:raven
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/raven-railgun-ppoi-replay"]
CMD ["--bind", "0.0.0.0:8088"]
