{
  "name": "@hisoka-io/railgun-poi-node-interface",
  "version": "0.1.0-alpha.0",
  "description": "A POINodeInterface for the Railgun engine that answers PPOI status on the device from a Raven node's list index and fetches PPOI auth paths from it by client-side PIR.",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json",
    "./src/*": "./src/*.ts"
  },
  "files": [
    "dist",
    "src"
  ],
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.cjs.json && tsc -p tsconfig.build.esm.json && node ../scripts/finalize-sdk-build.mjs",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --config tests/vitest.config.ts"
  },
  "dependencies": {
    "@railgun-community/poseidon-hash-wasm": "^1.0.2"
  },
  "peerDependencies": {
    "@railgun-community/engine": "^9.6.0 || 9.7.0-rc.0"
  },
  "peerDependenciesMeta": {
    "@railgun-community/engine": {
      "optional": true
    }
  },
  "devDependencies": {
    "@railgun-community/engine": "9.7.0-rc.0",
    "@types/node": "^20.0.0",
    "@types/semver": "^7.7.0",
    "raven-inspire-client-wasm": "file:../client-wasm/pkg-node",
    "semver": "^7.7.0",
    "typescript": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
