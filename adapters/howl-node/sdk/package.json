{
  "name": "@hisoka-io/raven-howl-client",
  "version": "0.1.0-alpha.0",
  "description": "Howl discovery over a Raven node: the public tag-prefix feed scanned on the device, private cell reads by PIR, and Merkle paths at a chosen leaf count.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hisoka-io/raven.git",
    "directory": "adapters/howl-node/sdk"
  },
  "homepage": "https://github.com/hisoka-io/raven",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --config tests/vitest.config.ts"
  },
  "peerDependencies": {
    "@hisoka-io/howl-client-wasm": "0.1.0-alpha.0"
  },
  "peerDependenciesMeta": {
    "@hisoka-io/howl-client-wasm": {
      "optional": true
    }
  },
  "devDependencies": {
    "@hisoka-io/howl-client-wasm": "link:../client-wasm/pkg-node",
    "@types/node": "20.19.39",
    "typescript": "5.9.3",
    "vitest": "2.1.9"
  }
}
